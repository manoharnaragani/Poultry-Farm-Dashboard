# Copy this file to ".env" (same folder) and fill in your values. Never share or upload ".env".

# Required: your PostgreSQL connection string (see SETUP-DATABASE.md)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.hwuouervddxglxvlxpac.supabase.co:5432/postgres

# Optional for local use. REQUIRED on a hosting server (used to create the admin login):
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# ADMIN_NAME=Your Name

# Hosting server only: allow new staff to register themselves (leave false normally)
# ALLOW_REGISTRATION=false

# Only if your database provider's certificate is rejected:
# DATABASE_SSL=no-verify
